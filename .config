# This is an empty file, please overwrite it after generating the .config file with the source code

# ============================================
# OpenWrt/LEDE 编译配置文件 - 带注释版本
# ============================================

# --- 目标平台配置 ---
CONFIG_TARGET_ramips=y                    # 选择 ramips 目标平台（Ralink/MediaTek 芯片）
CONFIG_TARGET_ramips_mt7621=y             # 选择 MT7621 子平台
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y  # 选择具体设备：新路由3 (Newifi D2)

# --- Aria2 下载工具配置 ---
CONFIG_ARIA2_BITTORRENT=y                 # 启用 Aria2 的 BT 下载支持
CONFIG_ARIA2_NOXML=y                      # 禁用 Aria2 的 XML-RPC 接口
CONFIG_ARIA2_OPENSSL=y                    # 使用 OpenSSL 作为 Aria2 的 SSL/TLS 库
CONFIG_ARIA2_WEBSOCKET=y                  # 启用 Aria2 的 WebSocket 支持

# --- GnuTLS 加密库功能配置 ---
CONFIG_GNUTLS_ALPN=y                      # 启用 ALPN (Application-Layer Protocol Negotiation) 支持
CONFIG_GNUTLS_ANON=y                      # 启用匿名认证支持
CONFIG_GNUTLS_DTLS_SRTP=y                 # 启用 DTLS-SRTP 支持（用于 WebRTC）
CONFIG_GNUTLS_HEARTBEAT=y                 # 启用心跳扩展支持
CONFIG_GNUTLS_OCSP=y                      # 启用 OCSP (Online Certificate Status Protocol) 支持
CONFIG_GNUTLS_PSK=y                       # 启用预共享密钥 (PSK) 支持

# --- 基础软件包 ---
CONFIG_PACKAGE_adbyby=y                   # Adbyby 广告屏蔽工具
CONFIG_PACKAGE_aria2=y                    # Aria2 多协议下载工具
CONFIG_PACKAGE_attendedsysupgrade-common=y # 自动系统升级通用组件
CONFIG_PACKAGE_attr=y                     # 文件扩展属性工具
CONFIG_PACKAGE_avahi-dbus-daemon=y        # Avahi mDNS/DNS-SD 服务（用于服务发现）
CONFIG_PACKAGE_baidupcs-web=y             # 百度网盘 Web 客户端
CONFIG_PACKAGE_blkid=y                    # 块设备 ID 查询工具
CONFIG_PACKAGE_boost=y                    # Boost C++ 库（基础包）
CONFIG_PACKAGE_boost-chrono=y             # Boost 时间处理库
CONFIG_PACKAGE_boost-program_options=y    # Boost 程序选项解析库
CONFIG_PACKAGE_boost-random=y             # Boost 随机数生成库
CONFIG_PACKAGE_boost-system=y             # Boost 系统库
CONFIG_PACKAGE_btrfs-progs=y              # Btrfs 文件系统工具
CONFIG_PACKAGE_cgi-io=y                   # CGI I/O 处理工具
CONFIG_PACKAGE_chinadns-ng=y              # ChinaDNS-NG 智能 DNS 工具
CONFIG_PACKAGE_collectd=y                 # Collectd 系统统计收集守护进程
CONFIG_PACKAGE_collectd-mod-cpu=y         # Collectd CPU 监控模块
CONFIG_PACKAGE_collectd-mod-interface=y   # Collectd 网络接口监控模块
CONFIG_PACKAGE_collectd-mod-iwinfo=y      # Collectd 无线信息模块
CONFIG_PACKAGE_collectd-mod-load=y        # Collectd 系统负载监控模块
CONFIG_PACKAGE_collectd-mod-memory=y      # Collectd 内存监控模块
CONFIG_PACKAGE_collectd-mod-network=y     # Collectd 网络传输模块
CONFIG_PACKAGE_collectd-mod-rrdtool=y     # Collectd RRDtool 输出模块
CONFIG_PACKAGE_coreutils=y                # GNU Coreutils 核心工具集
CONFIG_PACKAGE_coreutils-base64=y         # Base64 编码/解码工具
CONFIG_PACKAGE_coreutils-nohup=y         # nohup 命令（后台运行程序）
CONFIG_PACKAGE_dbus=y                     # D-Bus 消息总线系统
CONFIG_PACKAGE_e2fsprogs=y                # ext2/ext3/ext4 文件系统工具
CONFIG_PACKAGE_e2guardian=y               # E2guardian Web 内容过滤器
CONFIG_PACKAGE_frpc=y                     # FRP 客户端（内网穿透）
CONFIG_PACKAGE_haproxy=y                  # HAProxy 负载均衡器
CONFIG_PACKAGE_hd-idle=y                  # 硬盘空闲时自动停转工具
CONFIG_PACKAGE_https-dns-proxy=y          # HTTPS DNS 代理
CONFIG_PACKAGE_icu=y                      # ICU 国际化组件库
CONFIG_PACKAGE_ip-full=y                  # IP 路由工具（完整版）
CONFIG_PACKAGE_ipset=y                    # IPset 工具（IP 地址集合管理）
CONFIG_PACKAGE_ipt2socks=y                # ipt2socks 代理转换工具
CONFIG_PACKAGE_iptables-mod-tproxy=y      # iptables TPROXY 透明代理模块
CONFIG_PACKAGE_kmod-ipt-offload=y         # iptables 硬件卸载内核模块
CONFIG_PACKAGE_kmod-ipt-tproxy=y          # iptables TPROXY 内核模块
CONFIG_PACKAGE_kmod-nf-flow=y             # Netfilter 流表内核模块
CONFIG_PACKAGE_kmod-tcp-bbr=y             # TCP BBR 拥塞控制算法内核模块
CONFIG_PACKAGE_libatomic=y                # 原子操作库
CONFIG_PACKAGE_libattr=y                  # 扩展属性库
CONFIG_PACKAGE_libavahi-client=y          # Avahi 客户端库
CONFIG_PACKAGE_libavahi-dbus-support=y    # Avahi D-Bus 支持库
CONFIG_PACKAGE_libblkid=y                 # 块设备 ID 库
