CONFIG_PACKAGE_libtasn1=y                 # ASN.1 解析库
CONFIG_PACKAGE_libtirpc=y                 # TI-RPC 库
CONFIG_PACKAGE_libuuid=y                  # UUID 生成库
CONFIG_PACKAGE_libuv=y                    # libuv 异步 I/O 库
CONFIG_PACKAGE_libwebsockets-full=y       # WebSockets 库（完整版）
CONFIG_PACKAGE_libxml2=y                  # XML 解析库
CONFIG_PACKAGE_libzstd=y                  # Zstandard 压缩库
CONFIG_PACKAGE_lsblk=y                    # 列出块设备工具
