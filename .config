CONFIG_PACKAGE_libcap=y                   # Linux capabilities 库
CONFIG_PACKAGE_libcares=y                 # C-Ares 异步 DNS 解析库
CONFIG_PACKAGE_libcomerr=y                # 通用错误处理库
CONFIG_PACKAGE_libdaemon=y                # 守护进程库
CONFIG_PACKAGE_libdb47=y                  # Berkeley DB 4.7 数据库库
CONFIG_PACKAGE_libdbus=y                  # D-Bus 库
CONFIG_PACKAGE_libdouble-conversion=y     # 双精度转换库
CONFIG_PACKAGE_libelf=y                   # ELF 文件处理库
CONFIG_PACKAGE_libev=y                    # 高性能事件循环库
