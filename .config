CONFIG_PACKAGE_libext2fs=y                # ext2 文件系统库
CONFIG_PACKAGE_libffi=y                   # 外部函数接口库
CONFIG_PACKAGE_libgdbm=y                  # GDBM 数据库库
CONFIG_PACKAGE_libgnutls=y                # GnuTLS 加密库
CONFIG_PACKAGE_libipset=y                 # IPset 库
CONFIG_PACKAGE_libltdl=y                  # libtool 动态加载库
CONFIG_PACKAGE_liblzma=y                  # LZMA 压缩库
CONFIG_PACKAGE_liblzo=y                   # LZO 压缩库
CONFIG_PACKAGE_libmbedtls=y               # mbedTLS 加密库
CONFIG_PACKAGE_libmount=y                 # 文件系统挂载库
CONFIG_PACKAGE_libncurses=y               # ncurses 终端控制库
CONFIG_PACKAGE_libpcre2-16=y              # PCRE2 正则表达式库（16位）
