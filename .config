CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y       # PassWall 包含 Xray
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=y   # PassWall 包含 Hysteria（非 Hysteria2）
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Trojan_GO=y  # PassWall 包含 Trojan-Go
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray=y      # PassWall 包含 V2Ray
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_v2ray-plugin=y  # PassWall 包含 V2Ray 插件
