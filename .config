# --- Samba4 服务器配置 ---
CONFIG_SAMBA4_SERVER_AVAHI=y             # Samba4 启用 Avahi 支持
CONFIG_SAMBA4_SERVER_NETBIOS=y           # Samba4 启用 NetBIOS 支持
CONFIG_SAMBA4_SERVER_VFS=y               # Samba4 启用 VFS（虚拟文件系统）模块

# --- SQLite3 数据库配置 ---
CONFIG_SQLITE3_DYNAMIC_EXTENSIONS=y      # SQLite3 启用动态扩展
CONFIG_SQLITE3_FTS3=y                    # SQLite3 启用全文搜索 FTS3
CONFIG_SQLITE3_FTS4=y                    # SQLite3 启用全文搜索 FTS4
CONFIG_SQLITE3_FTS5=y                    # SQLite3 启用全文搜索 FTS5
CONFIG_SQLITE3_JSON1=y                   # SQLite3 启用 JSON1 扩展
CONFIG_SQLITE3_RTREE=y                   # SQLite3 启用 R-Tree 空间索引

# --- Trojan-Go 配置 ---
CONFIG_TROJAN_GO_COMPRESS_UPX=y          # Trojan-Go 使用 UPX 压缩

# --- V2Ray 配置 ---
CONFIG_V2RAY_COMPRESS_UPX=y              # V2Ray 使用 UPX 压缩
CONFIG_V2RAY_DISABLE_NONE=y              # V2Ray 禁用 None 加密方式
CONFIG_V2RAY_EXCLUDE_ASSETS=y            # V2Ray 排除资源文件
CONFIG_V2RAY_EXCLUDE_V2CTL=y             # V2Ray 排除 v2ctl 工具
CONFIG_V2RAY_JSON_INTERNAL=y             # V2Ray 使用内部 JSON 库

# --- Zstandard 压缩库配置 ---
CONFIG_ZSTD_OPTIMIZE_O3=y                # Zstandard 使用 O3 优化级别

# --- Boost 库配置 ---
CONFIG_boost-compile-visibility-hidden=y  # Boost 编译时隐藏符号可见性
CONFIG_boost-runtime-shared=y            # Boost 使用共享运行时库
CONFIG_boost-static-and-shared-libs=y    # Boost 同时编译静态和共享库
CONFIG_boost-variant-release=y           # Boost Variant 使用 Release 模式
